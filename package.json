{
  "name": "404-web-architect-studio",
  "version": "4.0.1",
  "description": "Constructor visual offline con Production Gate, PWA, auditoría real y exportación GitHub Pages.",
  "type": "module",
  "scripts": {
    "test": "node tools/validate-models.mjs && node tools/validate-app.mjs && node tools/validate-production-v4.mjs && node tools/smoke-v3.mjs",
    "test:models": "node tools/validate-models.mjs",
    "test:app": "node tools/validate-app.mjs",
    "test:production": "node tools/validate-production-v4.mjs",
    "test:smoke": "node tools/smoke-v3.mjs",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "keywords": [
    "web",
    "templates",
    "landing",
    "generator",
    "github-pages",
    "offline",
    "responsive",
    "offline-first",
    "pwa",
    "production-gate",
    "playwright",
    "commercial-kit",
    "e2e"
  ],
  "author": "I. Roig",
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.54.0",
    "jsdom": "^29.1.1"
  }
}
